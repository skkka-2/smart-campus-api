# 复制本文件为 .env 后填入真实值(.env 不进 Git)

# ===== 服务 =====
PORT=3007

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=item_01
MYSQL_POOL_SIZE=10
MYSQL_TIMEZONE=+08:00

# ===== JWT =====
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=10h

# ===== OpenAI(chatanywhere 或官方) =====
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=512

# ===== Agent =====
# 开启后会先用 JSON Mode 做意图/槽位抽取;模型不支持 response_format 时自动降级
AGENT_INTENT_EXTRACTION_ENABLED=true

# ===== 腾讯云 CLS Agent 可观测 =====
# 控制台 Agent 可观测应用对应的 Trace Topic ID
AGENT_OBSERVABILITY_ENABLED=false
CLS_DEFAULT_REGION=ap-guangzhou
CLS_TOPIC_ID=8de864a4-99c4-4af8-8695-e9ec8a561893
TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id
TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key
SERVICE_NAME=smart-campus-agent
AGENT_TRACE_SAMPLE_RATIO=1

# ===== 讯飞(暂未接入,预留) =====
XF_APP_ID=your_xf_app_id
XF_API_KEY=your_xf_api_key

# ===== CORS 白名单(逗号分隔) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
